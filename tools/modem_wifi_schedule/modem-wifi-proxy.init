#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1

start_service() {
    [ -f /lotusemmc/modem-wifi-schedule/config.json ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /lotusemmc/modem-wifi-schedule/modem_wifi_proxy.py --config /lotusemmc/modem-wifi-schedule/config.json
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /lotusemmc/modem-wifi-schedule/config.json
    procd_close_instance
}
